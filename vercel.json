{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "entrypoint": "Dockerfile.vercel",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/mark-alpha",
      "schedule": "15 3 * * *"
    }
  ]
}
